# Sao chép file này thành .env rồi điền giá trị thật. KHÔNG commit file .env.

# Môi trường chạy: development | production | test
NODE_ENV=development

# Cổng của backend
PORT=3000

# Chuỗi kết nối PostgreSQL (dùng từ khi có CSDL, Thư H.A. sẽ cập nhật)
# DATABASE_URL=postgresql://user:password@localhost:5432/studysync
