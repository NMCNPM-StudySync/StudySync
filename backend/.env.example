# ==============================================================================
# TỆP CẤU HÌNH BIẾN MÔI TRƯỜNG MẪU (BACKEND STUDYSYNC)
# ==============================================================================
# Hướng dẫn thiết lập:
# 1. Sao chép tệp này thành .env trong thư mục backend: cp .env.example .env
# 2. Điền chuỗi kết nối và mật khẩu thật lấy từ kênh bảo mật nội bộ (tin nhắn ghim trong nhóm chat riêng tư).
# 3. TUYỆT ĐỐI KHÔNG commit tệp .env thật hoặc chuỗi kết nối chứa mật khẩu lên Git repository.
# ==============================================================================

# Máy chủ HTTP
PORT=3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# Cơ sở dữ liệu đám mây PostgreSQL (Supabase - Tài nguyên dùng chung của nhóm)
# ------------------------------------------------------------------------------
# 1. DATABASE_URL: Kết nối qua Supabase Connection Pooler (Supavisor)
# Cổng 6543 (Transaction Mode - khuyến nghị cho ứng dụng Express backend runtime)
# Cổng 5432 (Session Mode - nếu cần dùng prepared statements)
# Host dạng: aws-0-[region].pooler.supabase.com (khu vực Singapore là aws-1-ap-southeast-1.pooler.supabase.com)
# User dạng: postgres.[project-ref] (bắt buộc có tenant ref để pooler định tuyến đúng project)
DATABASE_URL=postgresql://postgres.[project-ref]:[mật_khẩu_lấy_từ_kênh_nội_bộ]@aws-0-[region].pooler.supabase.com:6543/postgres?uselibpqcompat=true&sslmode=require

# 2. DIRECT_URL: Kết nối trực tiếp (Direct Connection - Cổng 5432)
# Dùng riêng khi chạy migration lược đồ CSDL bằng node-pg-migrate (npm run migrate:up).
# Host dạng: db.[project-ref].supabase.co, user dạng: postgres
DIRECT_URL=postgresql://postgres:[mật_khẩu_lấy_từ_kênh_nội_bộ]@db.[project-ref].supabase.co:5432/postgres?uselibpqcompat=true&sslmode=require

# Bắt buộc chế độ SSL khi chạy công cụ migration trên môi trường cloud/deploy
PGSSLMODE=require

# ------------------------------------------------------------------------------
# Bảo mật & Xác thực (JWT)
# ------------------------------------------------------------------------------
# Khóa ký JWT: Chuỗi ngẫu nhiên dài ít nhất 32 ký tự. Mỗi môi trường dùng khóa riêng.
JWT_SECRET=<chuỗi_ngẫu_nhiên_dài_ít_nhất_32_ký_tự>
# Thời gian sống của phiên đăng nhập (7 ngày)
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# Giao diện & Chia sẻ tài nguyên (CORS)
# ------------------------------------------------------------------------------
# Danh sách tên miền Frontend được phép gọi API (phân tách bằng dấu phẩy)
# Hỗ trợ đồng thời Localhost, Vercel chính thức và Cloudflare Pages dự phòng.
CORS_ORIGIN=http://localhost:5173,https://studysync.vercel.app,https://studysync.pages.dev
# Địa chỉ API mà frontend gọi (đồng bộ theo Template 5 và Vite frontend)
VITE_API_URL=http://localhost:3000/api

# ------------------------------------------------------------------------------
# Quy định nghiệp vụ (Business Rules)
# ------------------------------------------------------------------------------
# Múi giờ hiển thị và nhập liệu (BR-07). Dữ liệu trong CSDL luôn lưu theo UTC (timestamptz).
APP_TIMEZONE=Asia/Ho_Chi_Minh

# Kích thước tệp import tối đa, đơn vị MB (BR-05: tối đa 5 MB cho .ics, .csv và ảnh; 1 MB = 1024 × 1024 byte).
MAX_IMPORT_FILE_MB=5

# ------------------------------------------------------------------------------
# Integration test (npm run test:integration) - xem docs/testing/integration-tests.md
# ------------------------------------------------------------------------------
# CSDL PostgreSQL RIÊNG cho test: bắt buộc host localhost/127.0.0.1 và tên CSDL kết thúc bằng "_test".
# TUYỆT ĐỐI KHÔNG trỏ về Supabase dùng chung; bộ test tự từ chối chạy nếu sai.
# Lưu ý: vitest.integration.config.mts tự đặt PGSSLMODE=disable cho CSDL cục bộ.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/studysync_test
