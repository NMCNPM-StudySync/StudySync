# Sao chép file này thành .env rồi điền giá trị thật. KHÔNG commit file .env.
# Chỉ để giá trị mẫu, không để mật khẩu hay khóa thật.
# Giá trị thật nằm ở .env (không commit) và ở cấu hình của dịch vụ hosting.
 
# Máy chủ
# Môi trường chạy: development | production | test
NODE_ENV=development
# Cổng của backend
PORT=3000
 
# Cơ sở dữ liệu PostgreSQL
DATABASE_URL=postgresql://<user>:<mật_khẩu>@localhost:5432/studysync
 
# Bảo mật
# Khóa ký JWT: chuỗi ngẫu nhiên dài ít nhất 32 ký tự. Mỗi môi trường dùng khóa riêng.
JWT_SECRET=<chuỗi_ngẫu_nhiên_dài_ít_nhất_32_ký_tự>
# Thời gian sống của phiên đăng nhập (7 ngày)
JWT_EXPIRES_IN=7d
 
# Giao diện
# Địa chỉ frontend được phép gọi API (CORS). Dùng địa chỉ thật khi triển khai.
CORS_ORIGIN=http://localhost:5173
# Địa chỉ API mà frontend gọi (Vite chỉ đọc các biến bắt đầu bằng VITE_)
VITE_API_URL=http://localhost:3000/api
 
# Múi giờ hiển thị và nhập liệu (BR-07). Dữ liệu vẫn lưu theo UTC.
APP_TIMEZONE=Asia/Ho_Chi_Minh
 
# Import (BR-05)
# Kích thước tệp import tối đa, đơn vị MB (1 MB = 1024 × 1024 byte); áp dụng cho .ics, .csv và ảnh.
MAX_IMPORT_FILE_MB=5
 