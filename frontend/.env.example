# Biến môi trường frontend StudySync
# Sao chép file này thành .env để chạy local. KHÔNG commit file .env lên Git.

# Địa chỉ API backend của StudySync (mặc định localhost cổng 3000 kèm tiền tố /api)
VITE_API_URL=http://localhost:3000/api

# Dữ liệu giả cho trang Xếp lịch (TV3), chỉ có tác dụng khi chạy `npm run dev`; bản build luôn gọi backend thật.
# Đặt true để chụp ảnh giao diện khi chưa gọi được backend. Mặc định false.
VITE_USE_MOCK=false
